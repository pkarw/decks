{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkarw-decks",
  "account_id": "4baeda452978007339f3391bcc36b1e6",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pkarw-decks.openmercatocloud.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "pkarw-decks-media" }
  ]
}
